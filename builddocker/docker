FROM domoticz/domoticz:beta

RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# (optional but recommended)
ENV CC=gcc

# Install ALL Python deps in one layer
RUN pip3 install --no-cache-dir --prefer-binary \
    cffi \
    cryptography \
    requests==2.23.0 \
    charset-normalizer==3.0.1 \
    tinytuya